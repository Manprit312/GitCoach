PORT=3001

# Comma-separated allowed frontend origins (CORS + OAuth redirect)
# Local: http://localhost:4200
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:4200

# --- GitHub OAuth (optional) ---
# 1. Go to https://github.com/settings/developers
# 2. New OAuth App → fill form (see DEPLOY.md)
# 3. Paste Client ID + Secret below
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match the callback URL in your GitHub OAuth app exactly
# Local:  http://localhost:3001/api/auth/github/callback
# Vercel: https://your-app.vercel.app/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Personal access token — avoids GitHub API rate limits (recommended)
# Create at https://github.com/settings/tokens (public_repo scope is enough)
GITHUB_TOKEN=

# --- OpenAI (required) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Random string for signing session cookies (change in production)
SESSION_SECRET=change-me-in-production

# Set automatically on Railway/Render — do not hardcode locally
# NODE_ENV=production
